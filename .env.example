# Required for natural-language answers and ticket-aware conversations.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=qwen/qwen3.8-27b

# Required for the voice batch command. Use the same key for Gnani STT and TTS.
GNANI_API_KEY=

# Optional. Defaults to the supplied dataset folder beside this project.
# DATASET_DIR=C:\path\to\Capstone_Project_Dataset_FTTT_2026

# Voice defaults from the capstone brief.
GNANI_TTS_MODEL=timbre-v2.5
GNANI_TTS_VOICE=Kaveri
GNANI_LANGUAGE_CODE=en-IN
